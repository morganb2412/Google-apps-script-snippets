{
  "manifest_version": 3,
  "name": "Legacy DevBridge",
  "version": "0.6.1",
  "description": "Governed source control and conversational code assistance for Google Apps Script.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["sidePanel", "tabs"],
  "host_permissions": ["https://script.google.com/*", "http://127.0.0.1:8000/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "index.html" },
  "action": {
    "default_title": "Open Legacy DevBridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://script.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
